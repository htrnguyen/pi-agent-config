{
  "mcpServers": {
    "context7": {
      "headers": {
        "Authorization": "!printf 'Bearer %s' \"$(secret-tool lookup service context7)\""
      },
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ]
    }
  }
}