{
  "advisorEnabled": true,
  "defaultRole": "default",
  "advisoryRouter": {
    "enabled": true,
    "provider": "zai",
    "model": "glm-5.3-flash",
    "thinking": "low",
    "mode": "suggest-only",
    "confidenceThreshold": 0.85,
    "thresholds": {
      "toPaid": 0.9,
      "fromPaid": 0.75,
      "toCoding": 0.8,
      "default": 0.85
    },
    "maxSuggestionsPerTask": 1,
    "timeoutMs": 2200,
    "onFailure": "keep-current-role",
    "requireConfirmation": true,
    "paidRoles": [
      "plan",
      "slow"
    ],
    "neverAutoSwitch": true
  },
  "cycleOrder": [
    "default",
    "coding",
    "plan",
    "slow",
    "advisor"
  ],
  "modelRoles": {
    "default": {
      "model": "openai-codex/gpt-6-luna:low",
      "fallbacks": [
        "zai/glm-5.3-flash:low"
      ],
      "description": "Hỏi đáp, đọc hiểu codebase, phân tích ảnh & tác vụ hằng ngày (Codex Plus)"
    },
    "coding": {
      "model": "openai-codex/gpt-6-luna:medium",
      "fallbacks": [
        "antigravity/gemini-3.8-flash:medium"
      ],
      "description": "Implement, sửa bug & refactor chính (Codex Plus)"
    },
    "plan": {
      "model": "genz-codex/gpt-6.1-sol:high",
      "fallbacks": [
        "openai-codex/gpt-6-luna:high"
      ],
      "readOnly": true,
      "description": "Thiết kế kiến trúc & lập kế hoạch triển khai (Read-only, Sol)"
    },
    "slow": {
      "model": "genz-codex/gpt-6.1-terra:high",
      "fallbacks": [
        "openai-codex/gpt-6-luna:high"
      ],
      "description": "Debug sâu, race condition, bài toán kiến trúc khó (Terra)"
    },
    "advisor": {
      "model": "antigravity/gemini-3.8-flash:high",
      "fallbacks": [
        "zai/glm-5.3-flash:high"
      ],
      "readOnly": true,
      "description": "Review code độc lập, tìm edge cases & regression (Read-only)"
    }
  }
}
