{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "quietStartup": "header",
  "extensions": [
    "-builtin:mcp"
  ],
  "skills": [
    "!~/.agents/skills/**"
  ],
  "defaultTools": [
    "+codemode",
    "+tool_search"
  ],
  "subagents": {
    "defaultModel": "zai/glm-5.3-flash",
    "defaultThinking": "low",
    "agentOverrides": {
      "scout": {
        "model": "zai/glm-5.3-flash",
        "thinking": "low",
        "tools": [
          "read",
          "grep",
          "find",
          "ls"
        ],
        "output": false
      },
      "researcher": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "low"
      },
      "worker": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "medium",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash"
        ],
        "output": false
      },
      "oracle": {
        "disabled": true
      },
      "evidence-auditor": {
        "disabled": true
      },
      "delegate": {
        "disabled": true
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    }
  },
  "observational-memory": {
    "model": {
      "provider": "zai",
      "id": "glm-5.3-flash",
      "thinking": "low"
    },
    "observeAfterTokens": 12000,
    "reflectAfterTokens": 24000,
    "compactAfterTokens": 120000,
    "compactAfterTokensMode": "calibrated",
    "showWorkerNotifications": false
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@vigolium/piolium",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:context-mode",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:@plannotator/pi-extension",
    "npm:pi-goal-x",
    "npm:pi-observational-memory",
    "npm:pi-antigravity"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.88.1",
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.5.0"
  },
  "enableSkillCommands": false,
  "autocompleteMaxVisible": 12,
  "cacheWarming": "idle",
  "doubleEscapeAction": "tree",
  "fullscreenCopyOnSelect": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "detailedHud": true,
  "theme": "tokyo-clean",
  "compaction": {
    "enabled": true,
    "reserveTokens": 24000,
    "keepRecentTokens": 32000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000
  },
  "compactThresholdTokens": 120000
}